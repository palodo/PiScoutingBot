# logs/*.log

# Reports (optional - uncomment if you don't want to include existing reports)
# reportes/*

# Debug files (optional)
# debug_html/*

# Environment files (IMPORTANT: never include tokens in image)
.env
.env.local

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation
*.md
README.md
